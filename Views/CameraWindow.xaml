<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PickandPlace2026.Views.CameraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PickandPlace2026.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ComboBox x:Name="camera" Grid.Row="0" HorizontalAlignment="Stretch" SelectionChanged="Camera_SelectionChanged" />

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" MinWidth="800">
            <Image x:Name="CapturedImageBox" Stretch="Uniform" />
        </Border>

        <Button x:Name="button1" Grid.Row="2" Content="Start Camera" Width="320" HorizontalAlignment="Left" Click="Button1_Click" />
    </Grid>
</Window>
