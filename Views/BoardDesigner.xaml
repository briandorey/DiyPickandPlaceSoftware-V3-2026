<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickandPlace2026.Views.BoardDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PickandPlace2026.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:datagrid="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    PointerWheelChanged="Page_PointerWheelChanged">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Board Designer"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="2" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- X/Y jog pad -->
            <Grid Grid.Column="0" RowSpacing="4" ColumnSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="bt_Left" Content="&#9664;" FontSize="16" Width="64" Height="64" Margin="5"
                        Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" />
                <Button x:Name="bt_Up" Content="&#9650;" FontSize="16" Width="64" Height="64" Margin="5"
                        Grid.Row="0" Grid.Column="1" />
                <Button x:Name="bt_Right" Content="&#9654;" FontSize="16" Width="64" Height="64" Margin="5"
                        Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" />
                <Button x:Name="bt_Down" Content="&#9660;" FontSize="16" Width="64" Height="64" Margin="5"
                        Grid.Row="1" Grid.Column="1" />
            </Grid>

            <!-- Placement fields -->
            <Grid Grid.Column="1" RowSpacing="4" ColumnSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="X" Grid.Row="0" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_CameraX" Grid.Row="0" Grid.Column="1" Margin="5" Text="0.0" IsReadOnly="True" />
                <TextBlock Text="Y" Grid.Row="0" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_CameraY" Grid.Row="0" Grid.Column="3" Margin="5" Text="0.0" IsReadOnly="True" />
                <Button x:Name="bt_GetDRO" Content="Update" Margin="5" Click="bt_GetDRO_Click" Grid.Row="0" Grid.Column="4" />

                <TextBlock Text="Component" Grid.Row="1" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <ComboBox x:Name="dd_ComponentSelect" Grid.Row="1" Grid.Column="1" Margin="5" HorizontalAlignment="Stretch" />
                <TextBlock Text="Rotation" Grid.Row="1" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_Rotate" Grid.Row="1" Grid.Column="3" Margin="5" Text="0" />
                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <RadioButton x:Name="check_1" GroupName="PickerNozzle" Content="1" IsChecked="True" />
                    <RadioButton x:Name="check_2" GroupName="PickerNozzle" Content="2" />
                </StackPanel>

                <TextBlock Text="Jog Speed" Grid.Row="2" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <ComboBox x:Name="dd_distance" SelectedIndex="0" Margin="5" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem>5.0</ComboBoxItem>
                    <ComboBoxItem>2.0</ComboBoxItem>
                    <ComboBoxItem>1.0</ComboBoxItem>
                    <ComboBoxItem>0.5</ComboBoxItem>
                    <ComboBoxItem>0.1</ComboBoxItem>
                    <ComboBoxItem>0.05</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Ref ID" Grid.Row="2" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_ComName" Grid.Row="2" Grid.Column="3" Margin="5" />
                <Button x:Name="bt_addrow" Content="Add" Margin="5" Grid.Row="2" Grid.Column="4" Click="bt_addrow_Click" />
            </Grid>
        </Grid>

        <!-- Board info / outputs -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Margin="0,16,0,16">
            <ToggleSwitch x:Name="chk_HeadLED" Header="Head LED" OnContent="On" OffContent="Off" Toggled="chk_HeadLED_Toggled" />

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="PCB Name" VerticalAlignment="Center" />
                <TextBox x:Name="txt_BoardName" Width="140" />
                <TextBlock Text="PCB Height" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox x:Name="txt_BoardHeight" Width="80" Text="1.6" />
            </StackPanel>

            <Button x:Name="bt_Camera" ToolTipService.ToolTip="Camera" Width="76" Height="76" Margin="10,0" Click="bt_Camera_Click">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE722;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5" />
                    <TextBlock Text="Camera" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="bt_Home" ToolTipService.ToolTip="Home" Width="76" Height="76" Margin="10,0" Click="bt_HomeAll_Click">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE80F;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5" />
                    <TextBlock Text="Home" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="bt_SaveFile" ToolTipService.ToolTip="Save File" Width="76" Height="76" Margin="10,0" Click="bt_SaveFile_Click">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE74E;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5" />
                    <TextBlock Text="Save File" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="bt_eStop" ToolTipService.ToolTip="E-Stop" Width="76" Height="76" Margin="10,0"
                    Background="{ThemeResource SystemFillColorCriticalBrush}" Click="bt_eStop_Click">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="24" HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,5" />
                    <TextBlock Text="E-Stop" FontSize="11" HorizontalAlignment="Center" Foreground="White" />
                </StackPanel>
            </Button>
        </StackPanel>

        <datagrid:DataGrid x:Name="_dgBoard"
                            Grid.Row="4"
                            AutoGenerateColumns="False"
                            CanUserResizeColumns="True"
                            SelectionChanged="_dgBoard_SelectionChanged" />
    </Grid>
</Page>
