<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickandPlace2026.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PickandPlace2026.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:datagrid="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ItemTitle" Text="Please Load PCB File"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Grid.Row="0" Margin="0,0,0,8" />

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,12" VerticalAlignment="Center">
            <Button x:Name="bt_Load" ToolTipService.ToolTip="Load PCB File" Click="Bt_Load_Click">
                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
            </Button>
            <Button x:Name="bt_Save" ToolTipService.ToolTip="Save PCB File" Click="Bt_Save_Click">
                <FontIcon Glyph="&#xE74E;" FontSize="16" />
            </Button>
            <Button x:Name="bt_ViewPCB" ToolTipService.ToolTip="View Loaded PCB" Click="Bt_ViewPCB_Click">
                <FontIcon Glyph="&#xE890;" FontSize="16" />
            </Button>

            <Border Width="1" Height="24" Background="Gray" Opacity="0.3" Margin="6,0" />

            <Button x:Name="bt_CheckAll" ToolTipService.ToolTip="Check All" Click="Bt_CheckAll_Click">
                <FontIcon Glyph="&#xE73E;" FontSize="16" />
            </Button>
            <Button x:Name="bt_UnCheckAll" ToolTipService.ToolTip="Uncheck All" Click="Bt_UnCheckAll_Click">
                <FontIcon Glyph="&#xE711;" FontSize="16" />
            </Button>

            <Border Width="1" Height="24" Background="Gray" Opacity="0.3" Margin="6,0" />

            <Button x:Name="bt_Camera" ToolTipService.ToolTip="Camera" Click="Bt_Camera_Click">
                <FontIcon Glyph="&#xE722;" FontSize="16" />
            </Button>
            <Button x:Name="bt_Stop" ToolTipService.ToolTip="Stop Build" Click="Bt_Stop_Click">
                <FontIcon Glyph="&#xE71A;" FontSize="16" />
            </Button>
            <Button x:Name="bt_ChipFeeder" ToolTipService.ToolTip="Activate Chip Feeder" Click="Bt_ChipFeeder_Click">
                <FontIcon Glyph="&#xE950;" FontSize="16" />
            </Button>

            <TextBlock Text="Motor run time" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox x:Name="csfeeder" Text="20" Width="60" />
            <CheckBox x:Name="pickdelay" Content="High Speed" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Feeders / components -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="220" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Feeders list + Start/Stop/E-Stop - these three are the most-used
                 controls during a build, so they get a large, hard-to-miss hit
                 area here instead of small icon buttons in the toolbar. -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <datagrid:DataGrid x:Name="_dgFeeders"
                                    Grid.Column="0"
                                    AutoGenerateColumns="False"
                                    CanUserSortColumns="False"
                                    CanUserResizeColumns="True"
                                    Margin="0,0,0,8" />

                <Grid Grid.Column="1" RowSpacing="8" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button x:Name="bt_Start" Grid.Row="0" Click="Bt_Start_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="22" />
                            <TextBlock Text="Start" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="bt_Home" Grid.Row="1" Click="Bt_HomeAll_Click"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE80F;" FontSize="22" />
                            <TextBlock Text="Home" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="bt_eStop" Grid.Row="2" Click="Bt_eStop_Click"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="{ThemeResource SystemFillColorCriticalBrush}">
                        <!-- Button's default style only uses the Background above
                             for the Normal state - PointerOver/Pressed fall back
                             to the theme's own light brushes unless overridden
                             here, which is what was turning the button white (and
                             the white text/icon invisible) on hover. -->
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFE05252" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFA82424" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7BA;" FontSize="22" Foreground="White" />
                            <TextBlock Text="E-Stop" FontSize="18" VerticalAlignment="Center" Foreground="White" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <datagrid:DataGrid x:Name="_dgComponents"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                CanUserSortColumns="False"
                                CanUserResizeColumns="True"
                                SelectionChanged="_dgComponents_SelectionChanged" />
        </Grid>
    </Grid>
</Page>
