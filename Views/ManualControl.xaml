<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickandPlace2026.Views.ManualControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PickandPlace2026.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Manual Control"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Jog pad -->
            <Grid Grid.Column="0" RowSpacing="4" ColumnSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="X / Y" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="Z" Grid.Row="0" Grid.Column="3" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="A" Grid.Row="0" Grid.Column="4" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button x:Name="bt_Left" Content="&#9664;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" />
                <Button x:Name="bt_Up" Content="&#9650;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="1" Grid.Column="1" />
                <Button x:Name="bt_Right" Content="&#9654;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" />
                <Button x:Name="bt_Down" Content="&#9660;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" />

                <Button x:Name="bt_ZUp" Content="&#9650;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="1" Grid.Column="3" />
                <Button x:Name="bt_ZDown" Content="&#9660;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="2" Grid.Column="3" VerticalAlignment="Bottom" />

                <Button x:Name="bt_AUp" Content="&#9650;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="1" Grid.Column="4" />
                <Button x:Name="bt_ADown" Content="&#9660;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="2" Grid.Column="4" VerticalAlignment="Bottom" />

                <TextBlock Text="B" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="C" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button x:Name="bt_BLeft" Content="&#9664;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="4" Grid.Column="0" />
                <Button x:Name="bt_BRight" Content="&#9654;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="4" Grid.Column="1" />
                <Button x:Name="bt_CLeft" Content="&#9664;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="4" Grid.Column="2" />
                <Button x:Name="bt_CRight" Content="&#9654;" FontSize="20" Width="64" Height="64" Margin="5"
                        Grid.Row="4" Grid.Column="3" />
            </Grid>

            <!-- DRO / jog settings / go-to-location -->
            <Grid Grid.Column="1" RowSpacing="4" ColumnSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- DRO -->
                <TextBlock Text="X" Grid.Row="0" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_CameraX" Grid.Row="0" Grid.Column="1" Margin="5" Text="0.0" IsReadOnly="True" />
                <TextBlock Text="Y" Grid.Row="0" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_CameraY" Grid.Row="0" Grid.Column="3" Margin="5" Text="0.0" IsReadOnly="True" />
                <Button x:Name="bt_GetDRO" Content="Update" Margin="5" Click="bt_GetDRO_Click" Grid.Row="0" Grid.Column="4" />

                <TextBlock Text="Z" Grid.Row="1" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_CameraZ" Grid.Row="1" Grid.Column="1" Margin="5" Text="0" IsReadOnly="True" />
                <TextBlock Text="A" Grid.Row="1" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_CameraA" Grid.Row="1" Grid.Column="3" Margin="5" Text="0" IsReadOnly="True" />

                <TextBlock Text="B" Grid.Row="2" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_CameraB" Grid.Row="2" Grid.Column="1" Margin="5" Text="0" IsReadOnly="True" />
                <TextBlock Text="C" Grid.Row="2" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_CameraC" Grid.Row="2" Grid.Column="3" Margin="5" Text="0" IsReadOnly="True" />

                <!-- Jog speed / feeder select -->
                <TextBlock Text="Jog Speed" Grid.Row="3" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <ComboBox x:Name="dd_distance" SelectedIndex="1" Margin="5" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem>10.0</ComboBoxItem>
                    <ComboBoxItem>5.0</ComboBoxItem>
                    <ComboBoxItem>2.0</ComboBoxItem>
                    <ComboBoxItem>1.0</ComboBoxItem>
                    <ComboBoxItem>0.5</ComboBoxItem>
                    <ComboBoxItem>0.1</ComboBoxItem>
                    <ComboBoxItem>0.05</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Feeder" Grid.Row="3" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <ComboBox x:Name="dd_FeederSelect" SelectedIndex="0" Margin="5" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Stretch">
                    <ComboBoxItem>0</ComboBoxItem>
                    <ComboBoxItem>1</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                    <ComboBoxItem>6</ComboBoxItem>
                    <ComboBoxItem>7</ComboBoxItem>
                    <ComboBoxItem>8</ComboBoxItem>
                    <ComboBoxItem>9</ComboBoxItem>
                    <ComboBoxItem>10</ComboBoxItem>
                    <ComboBoxItem>11</ComboBoxItem>
                    <ComboBoxItem>12</ComboBoxItem>
                    <ComboBoxItem>13</ComboBoxItem>
                    <ComboBoxItem>14</ComboBoxItem>
                    <ComboBoxItem>15</ComboBoxItem>
                </ComboBox>
                <Button x:Name="bt_getFeeder" Content="Select" Margin="5" Grid.Row="3" Grid.Column="4" Click="bt_getFeeder_Click" />

                <TextBlock Text="Move to entered location" FontWeight="SemiBold" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Margin="5,12,5,5" />

                <TextBlock Text="X" Grid.Row="5" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_goX" Grid.Row="5" Grid.Column="1" Margin="5" Text="0.0" />
                <TextBlock Text="Y" Grid.Row="5" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_goY" Grid.Row="5" Grid.Column="3" Margin="5" Text="0.0" />

                <TextBlock Text="Z" Grid.Row="6" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_goZ" Grid.Row="6" Grid.Column="1" Margin="5" Text="0" />
                <TextBlock Text="A" Grid.Row="6" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_goA" Grid.Row="6" Grid.Column="3" Margin="5" Text="0" />

                <TextBlock Text="B" Grid.Row="7" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_goB" Grid.Row="7" Grid.Column="1" Margin="5" Text="0" />
                <TextBlock Text="C" Grid.Row="7" Grid.Column="2" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBox x:Name="txt_goC" Grid.Row="7" Grid.Column="3" Margin="5" Text="0" />

                <TextBlock Text="Speed" Grid.Row="8" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <NumberBox x:Name="num_Speed" Grid.Row="8" Grid.Column="1" Margin="5" Value="100" Minimum="1" Maximum="150" SpinButtonPlacementMode="Compact" SmallChange="10" />
                <Button x:Name="bt_runto" Content="Run to Location" Margin="5" Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3" Click="bt_runto_Click" />

                <TextBlock Text="Component" Grid.Row="9" Grid.Column="0" Margin="5" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <ComboBox x:Name="dd_ComponentSelect" SelectedIndex="0" Margin="5" Grid.Row="9" Grid.Column="1" HorizontalAlignment="Stretch" />
                <Button x:Name="bt_selcomp" Content="Run to Component" Margin="5" Grid.Row="9" Grid.Column="2" Grid.ColumnSpan="3" Click="bt_selcomp_Click" />
            </Grid>
        </Grid>
        </ScrollViewer>

        <!-- Outputs / global actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Margin="0,16,0,0">
            <ToggleSwitch x:Name="chk_HeadLED" Header="Head LED" OnContent="On" OffContent="Off" Toggled="chk_HeadLED_Toggled" Margin="0" Padding="0" MinWidth="0" />
            <ToggleSwitch x:Name="chk_BaseLED" Header="Base LED" OnContent="On" OffContent="Off" Toggled="chk_BaseLED_Toggled" Margin="0" MinWidth="0" />
            <ToggleSwitch x:Name="chk_Vac1" Header="Vac 1" OnContent="On" OffContent="Off" Toggled="chk_Vac1_Toggled" Margin="0" MinWidth="0" />
            <ToggleSwitch x:Name="chk_Vac2" Header="Vac 2" OnContent="On" OffContent="Off" Toggled="chk_Vac2_Toggled" Margin="0" MinWidth="0" />

            <Button x:Name="bt_Camera" ToolTipService.ToolTip="Camera" Width="76" Height="76" Margin="0,0" Click="bt_Camera_Click">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE722;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5" />
                    <TextBlock Text="Camera" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="bt_Home" ToolTipService.ToolTip="Home" Width="76" Height="76" Margin="0,0" Click="bt_HomeAll_Click">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE80F;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5" />
                    <TextBlock Text="Home" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Vertical" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="ind_Homed" Width="16" Height="16" CornerRadius="8" Background="Gray" />
                <TextBlock x:Name="txt_Homed" Text="Not Homed" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="bt_ChipFeeder" ToolTipService.ToolTip="Activate Chip Feeder" Width="76" Height="76" Margin="0,0" Click="bt_ChipFeeder_Click">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE950;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5" />
                    <TextBlock Text="Chip" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="bt_eStop" ToolTipService.ToolTip="E-Stop" Width="76" Height="76" Margin="0,0"
                    Background="{ThemeResource SystemFillColorCriticalBrush}" Click="bt_eStop_Click">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="24" HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,5" />
                    <TextBlock Text="E-Stop" FontSize="11" HorizontalAlignment="Center" Foreground="White" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Vertical" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="ind_EStop" Width="16" Height="16" CornerRadius="8" Background="Gray" />
                <TextBlock x:Name="txt_EStop" Text="Ready" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
